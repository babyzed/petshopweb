# ============================================================
# پت‌شاپ — تنظیمات محیطی (Production)
# کپی کنید به .env و مقادیر را تغییر دهید
# ============================================================

# ---------- سرور ----------
PORT=3000
NODE_ENV=production

# ---------- امنیت ----------
# کلید JWT — حتماً تغییر دهید! تولید:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS

# اگر سایت پشت reverse-proxy (مثل nginx) اجرا می‌شود 1 قرار دهید
# تا IP واقعی کاربر برای rate limit و لاگ درست تشخیص داده شود
TRUST_PROXY=0

# سفارش‌های آنلاینِ پرداخت‌نشده بعد از چند ساعت به‌صورت خودکار لغو
# و موجودی آزاد می‌شود (فقط سفارش‌های آنلاین؛ COD دست فروشگاه است)
ORDER_EXPIRY_HOURS=12

# ---------- دروازه پرداخت (بانک سامان) ----------
# مستندات: https://developer.sep.ir
SAMAN_TERMINAL_ID=
SAMAN_USERNAME=
SAMAN_PASSWORD=
SAMAN_SANDBOX=false
SAMAN_CALLBACK_URL=https://yourdomain.com/api/payments/callback

# ---------- پیامک (Kavenegar) ----------
# ثبت‌نام: https://kavenegar.com
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ---------- ایمیل (SMTP) ----------
# Gmail: smtp.gmail.com:587
# اگر تنظیم نشود، ایمیل‌ها فقط در لاگ نمایش داده می‌شوند
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@yourdomain.com

# ---------- گوگل آنالیتیکس ----------
# شناسه اندازه‌گیری از Google Analytics 4
# اگر تنظیم شود، کد GA در سایت نمایش داده می‌شود
GA_MEASUREMENT_ID=
