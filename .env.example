# ============================================================
# پت‌شاپ — تنظیمات محیطی (Production)
# کپی کنید به .env و مقادیر را تغییر دهید
# ============================================================

# ---------- سرور ----------
PORT=3000
NODE_ENV=production

# ---------- امنیت ----------
# کلید JWT — حتماً تغییر دهید! تولید:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS

# اگر سایت پشت reverse-proxy (مثل nginx) اجرا می‌شود 1 قرار دهید
# تا IP واقعی کاربر برای rate limit و لاگ درست تشخیص داده شود
TRUST_PROXY=0

# سفارش‌های آنلاینِ پرداخت‌نشده بعد از چند ساعت به‌صورت خودکار لغو
# و موجودی آزاد می‌شود (فقط سفارش‌های آنلاین؛ COD دست فروشگاه است)
ORDER_EXPIRY_HOURS=12

# ---------- آدرس عمومی سایت ----------
# برای ساخت لینک‌های بازیابی رمز و ایمیل سفارش (نه آدرس callback بانک)
# اگر خالی باشد از آدرس درخواست جاری استفاده می‌شود
SITE_URL=https://yourdomain.com

# ---------- دروازه پرداخت ----------
# درگاه فعال: saman | zarinpal | melli | saderat
# (قابل تغییر از پنل مدیریت → تنظیمات → پرداخت؛ مقدار پنل بر .env اولویت دارد)
PAYMENT_GATEWAY=saman

# آدرس بازگشت مشترک همهٔ درگاه‌ها — همین آدرس را در پنل پذیرندگی بانک ثبت کنید
PAYMENT_CALLBACK_URL=https://yourdomain.com/api/payments/callback

# --- بانک سامان (Sepehr REST) — https://developer.sep.ir
SAMAN_TERMINAL_ID=
SAMAN_SANDBOX=false

# --- زرین‌پال — https://www.zarinpal.com/docs
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# --- بانک ملی (پرداخت الکترونیک سداد) — https://sadad.shaparak.ir
MELLI_MERCHANT_ID=
MELLI_TERMINAL_ID=
MELLI_TERMINAL_KEY=

# --- بانک صادرات (پرداخت الکترونیک سپهر) — https://sepehr.shaparak.ir
SADERAT_TERMINAL_ID=
# برای پذیرندگان مبنا کارت آریا: mabna.shaparak.ir
SADERAT_HOST=sepehr.shaparak.ir

# ---------- پیامک (آموت — AmootSMS) ----------
# ثبت‌نام: https://www.amootsms.com  |  مستندات: https://doc.amootsms.com/Documentation
# توکن REST را از پنل آموت (وب‌سرویس ← توکن‌ها) بسازید
AMOOT_TOKEN=
# خط خدماتی (پیامک سفارش‌ها و پیامک تستی) — برای خط اشتراکی مقدار public
AMOOT_LINE_SERVICE=public
# خط ارسال کد تایید (در صورت خالی بودن از خط خدماتی استفاده می‌شود)
AMOOT_LINE_OTP=
# خط تبلیغاتی (ارسال انبوه)
AMOOT_LINE_ADS=
# کد الگوی کد تایید (اختیاری) — در صورت تنظیم، OTP با متد SendWithPattern ارسال می‌شود
AMOOT_OTP_PATTERN_ID=

# ---------- ایمیل (SMTP) ----------
# Gmail: smtp.gmail.com:587
# اگر تنظیم نشود، ایمیل‌ها فقط در لاگ نمایش داده می‌شوند
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@yourdomain.com

# ---------- گوگل آنالیتیکس ----------
# شناسه اندازه‌گیری از Google Analytics 4
# اگر تنظیم شود، کد GA در سایت نمایش داده می‌شود
GA_MEASUREMENT_ID=
